# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test / quality caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# IDEs / editors
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local environment / secrets
.env
.env.*
!.env.example

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Note:
# uv.lock is intentionally NOT ignored. Interconnect Studio is an application,
# so the lock file should be committed for reproducible development and CI.
